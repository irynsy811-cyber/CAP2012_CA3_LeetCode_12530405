/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode(int x) : val(x), next(NULL) {}
 * };
 */
class Solution {
public:
    bool hasCycle(ListNode *head) {
      
        ListNode*tmp=head;
        ListNode*t=head;
        while(tmp != nullptr&& tmp->next !=nullptr){
            tmp= tmp-> next ->next;
            t=t -> next;
           if(tmp==t){
            return true;
           }
        }
        return false;
           
    }
};
